{
  "tagline": "عيلة مش زي أي عيلة. ولاء، قوة، وأسلوب ماشي بخطة تحت قيادة VOLT.",
  "serverName": "كيان رول بلاي [KYN]",
  "discordInvite": "https://discord.gg/5Pa2GNGUS",
  "about": "فانتومز (PHANTOMS) عائلة رول بلاي عريقة على سيرفر كيان، تأسست بهدف بناء اسم وهيبة تُحترم في كل شبر بالمدينة. نؤمن بأن الذكاء والولاء والترابط الأخوي أهم من مجرد حمل السلاح، ونسعى دائماً لتقديم أفضل سيناريوهات الرول بلاي والسيطرة باحترافية.",
  "rules": [
    {
      "title": "الولاء التام والانضباط",
      "desc": "خيانة العائلة أو تسريب أسرار المقرات والمخططات عقوبتها التصفية والطرد النهائي وبلاك ليست."
    },
    {
      "title": "احترام التسلسل الإداري",
      "desc": "أوامر البوس ونوابه نافذة بدون نقاش، ويجب احترام جميع الإداريين والأعضاء بغض النظر عن الرتبة."
    },
    {
      "title": "قواعد الاشتباكات والحروب",
      "desc": "ممنوع فتح أي عداوة أو إطلاق رصاص على أي عصابة أو مواطن أو قطاع أمني إلا بإذن صريح من القيادة العليا."
    },
    {
      "title": "الالتزام التام بقوانين السيرفر (RP)",
      "desc": "ممنوع قطعياً الـ RDM, VDM, FearRP, أو التكلم OOC أثناء السيناريو. الهيبة تُبنى بالرول بلاي النظيف."
    },
    {
      "title": "المظهر الموحد وحضور الاجتماعات",
      "desc": "الالتزام بلباس العائلة الرسمي وألوان المركبات المعتمدة، والتواجد الإجباري في التجمعات والنداءات الطارئة."
    }
  ],
