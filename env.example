# إعدادات ديسكورد (Discord Developer Portal > OAuth2)
CLIENT_ID=
CLIENT_SECRET=

# رابط التحويل (Redirect URI) - ضعه مطابقاً لما وضعته في Discord Developer Portal
REDIRECT=http://localhost:3000/callback

# آيدي سيرفر الديسكورد للعصابة/العائلة (Developer Mode > Copy Server ID)
GUILD_ID=

# آيديات الرتب بالترتيب من الأعلى للأدنى (مفصولة بفاصلة):
# Boss, Co-Boss, Manager, Admin, Member, Regular
ROLE_IDS=

# الآيدي الخاص بك في ديسكورد (يدخلك برتبة Boss فوراً حتى قبل ضبط الرتب)
OWNER_ID=

# مفتاح تشفير الجلسات (أي نص طويل عشوائي)
SECRET=change-me-to-a-very-long-random-secret-key-12345

# رابط سيرفر الديسكورد للعصابة (رابط الدعوة المباشر)
DISCORD_INVITE=https://discord.gg/your-gang-invite

# رابط ويب هوك قناة التقديمات في ديسكورد (Discord Webhook URL)
# لإرسال إشعارات التقديمات الجديدة وقرارات القبول والرفض مباشرة إلى الديسكورد
DISCORD_WEBHOOK_URL=

# المنفذ المحلي
PORT=3000
