# من Discord Developer Portal > OAuth2
CLIENT_ID=
CLIENT_SECRET=
# لازم يطابق الـ Redirect المضاف في ديسكورد
REDIRECT=http://localhost:3000/callback
# ID سيرفر ديسكورد بتاع العيلة (Developer Mode > Copy Server ID)
GUILD_ID=
# IDs الرتب بالترتيب: Boss,Co-Boss,Manager,Admin,Member,Regular
ROLE_IDS=
# الـ ID بتاعك (يدخلك كـ Boss حتى لو الرتب لسه متظبطتش)
OWNER_ID=
# أي نص طويل عشوائي
SECRET=change-me-to-a-long-random-string
PORT=3000
